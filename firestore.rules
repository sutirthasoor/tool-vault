rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin(){ return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      // first-ever admin: allowed only until meta/adminLock exists
      allow create: if request.auth != null && request.auth.uid == id && !exists(/databases/$(db)/documents/meta/adminLock);
      allow create, delete: if isAdmin();   // existing admins add/remove admins
    }
    match /meta/{id} {
      allow read: if true;
      allow create: if id == 'adminLock' && request.auth != null && !exists(/databases/$(db)/documents/meta/adminLock)
        && existsAfter(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    // Home hero slider: one doc per slide, base64 image string inside
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tools/{id}   { allow read: if true; allow write: if isAdmin(); }
    // URL + password live here, NOT in the public tools doc
    match /secrets/{id} {
      allow read: if isAdmin()
        || get(/databases/$(db)/documents/tools/$(id)).data.access == 'free'
        || (request.auth != null && id in get(/databases/$(db)/documents/users/$(request.auth.uid)).data.purchasedIds);
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // DEMO ONLY: client can edit own purchases/wallet because payment is simulated.
      // Replace with a Cloud Function after a real gateway webhook.
    }
  }
}
